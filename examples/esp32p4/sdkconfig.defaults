# ESP32-P4 revision 1.x, WT99P4C5-S1; measured CPU clock 360 MHz.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_L2D_SRM_ROI=y

# ---- LVGL ----
CONFIG_LV_DEF_REFR_PERIOD=5
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Single software draw unit; Live2D uses its own PPA conversion path.
CONFIG_LV_DRAW_BUF_ALIGN=64
# Keep LVGL's PPA draw unit disabled to avoid sharing Live2D transactions.
CONFIG_LV_USE_PPA=n
CONFIG_LV_USE_PPA_IMG=n
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
CONFIG_LV_CACHE_DEF_SIZE=32
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=256

# ---- FreeType via ESP LVGL Adapter ----
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y

# ---- FATFS ----
CONFIG_FATFS_LFN_HEAP=y
# 模型/资源可能含中文长文件名；对外路径以 UTF-8 暴露。
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_CODEPAGE=936
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# ---- Board ----
CONFIG_BSP_I2C_NUM=0
# CONFIG_BSP_I2C_FAST_MODE is not set
CONFIG_BSP_I2C_CLK_SPEED_HZ=100000
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_BRIGHTNESS_LEDC_CH=0

# ---- FreeRTOS ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1500
CONFIG_FREERTOS_HZ=1000
# 每核 Idle 任务运行时间用于测量 CPU 占用；ESP Timer 微秒计数，64 位避免溢出。
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM is not set
# CONFIG_FREERTOS_UNICORE is not set

# ---- Diagnostics / Stability ----
# Live2D/PainterEngine is CPU-bound; keep production builds on -O2 for frame-rate validation.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 栈溢出会静默踩踏相邻内存；开启栈金丝雀 + 栈尾 watchpoint 精确定位溢出任务。
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# CONFIG_LCD_ENABLE_DEBUG_LOG is not set
# Bootloader 日志关闭：ESP32-P4 bootloader 在 0x8000 偏移上限 0x6000，INFO 日志会超限。
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ---- Misc ----
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# ---- Heap ----
CONFIG_HEAP_POISONING_DISABLED=y

# ---- Partition Table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- SPIRAM ----
CONFIG_SPIRAM=y
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
# 256 KB L2 leaves a 256 KB DMA heap, so the old 256 KB reserve does not fit.
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# CONFIG_SPIRAM_USE_MEMMAP is not set
CONFIG_SPIRAM_USE_MALLOC=y
